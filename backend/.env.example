GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
CREDIT_BUDGET=5000
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=canned
# Set LLM_PROVIDER to any non-empty name other than canned/none/off to enable
# the Chat Completions provider (for example: evon, gemini, groq, openai).
# Evon v3.3 (Gnani closed beta) example — use the base URL and model name from
# your Gnani beta onboarding, then set the same values on Render:
#   LLM_PROVIDER=evon
#   LLM_CHAT_URL=https://<evon-beta-host>/v1/chat/completions
#   LLM_MODEL=<evon-v3.3-model-id>
# Example for Gemini (flash-lite has the fastest free-tier replies):
#   LLM_PROVIDER=gemini
#   LLM_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
LLM_CHAT_URL=
LLM_MODEL=

# Voice enrolment / clone quality
MIN_ENROL_SECONDS=5
MAX_ENROL_SECONDS=30
MAX_UPLOAD_MB=10
CLONE_TTS_SAMPLE_RATE=44100
STOCK_TTS_SAMPLE_RATE=48000

# Prisma v2.5 live STT (one concrete locale per session)
STT_LANGUAGE=en-IN
STT_FORMAT=verbatim
STT_VAD_THRESHOLD=0.50
STT_MIN_SPEECH_MS=80
STT_MIN_SEGMENT_MS=120
STT_MIN_SILENCE_MS=700
STT_MAX_SPEECH_S=30
STT_IDLE_TIMEOUT_SEC=300
